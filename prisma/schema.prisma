// Conciliador Plazet — esquema de base de datos
// Prisma 7 + PostgreSQL en Neon (adapter pg), igual que la nómina.
// Base "conciliador" en la misma instancia Neon de la nómina (datos aparte).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Una tienda / punto de venta de Habbie
model Store {
  id             Int             @id @default(autoincrement())
  code           String          @unique // B1, B2, B3, PRIN, JP
  name           String
  alegraBodega   String // texto EXACTO de la columna BODEGA en Alegra
  establishment  String? // CODIGO ESTABLECIMIENTO del datafono
  terminalVisa   String?
  terminalMaster String?
  active         Boolean         @default(true)
  cashRefs       CashReference[]
}

/// Referencia de consignación de efectivo del banco -> tienda
/// (cada tienda consigna con una o varias referencias fijas)
model CashReference {
  id        Int    @id @default(autoincrement())
  reference String @unique
  storeId   Int
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

/// Día festivo / no hábil en Colombia (editable)
model Holiday {
  id   Int    @id @default(autoincrement())
  date String @unique // YYYY-MM-DD
  name String
}

/// Una corrida de conciliación (LEGADO — se conserva para no perder historial;
/// el flujo actual usa las tablas acumuladas de abajo)
model Run {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  label       String?
  periodStart String? // YYYY-MM-DD
  periodEnd   String? // YYYY-MM-DD

  // Datos parseados y resultados (JSON serializado)
  salesJson       String  @default("[]") // facturas Alegra deduplicadas
  bankJson        String  @default("[]") // movimientos banco efectivo
  dataphoneJson   String  @default("[]") // transacciones datafono
  qrBankJson      String  @default("[]") // pagos QR del extracto del datafono
  resultsJson     String  @default("[]") // conciliación calculada
  adjustmentsJson String  @default("[]") // ajustes manuales
}

// ───────────── Datos acumulados (conciliación continua por mes) ─────────────
// Cada carga REEMPLAZA su rango de fechas: el archivo es la fuente de verdad
// del periodo que cubre. Los meses cerrados no se tocan.

/// Una venta (transacción/factura de Alegra o del sistema histórico)
model Sale {
  id        Int    @id @default(autoincrement())
  date      String // YYYY-MM-DD
  invoice   String
  bodega    String // texto crudo de la cuenta/bodega de origen
  storeCode String?
  method    String // EFECTIVO | TARJETA_CREDITO | TARJETA_DEBITO | TRANSFERENCIA | OTRO
  amount    Float
  source    String @default("alegra") // alegra | historico

  @@index([date])
}

/// Movimiento del extracto de la cuenta de EFECTIVO
model BankEntry {
  id        Int     @id @default(autoincrement())
  date      String // YYYY-MM-DD
  concept   String
  amount    Float
  reference String?
  kind      String // RECAUDO_EFECTIVO | CONSIG_TRANSFER | OTRO

  @@index([date])
}

/// Pago QR del extracto de la cuenta del DATAFONO (CSV 191)
model QrEntry {
  id      Int    @id @default(autoincrement())
  date    String // YYYY-MM-DD
  concept String
  amount  Float
  payer   String

  @@index([date])
}

/// Operación aprobada del reporte de liquidaciones (settlement) de Mercado Pago.
/// Es el "recaudo" del canal Mercadopago; no trae tienda (se compara a nivel
/// empresa, igual que el QR).
model MercadopagoEntry {
  id      Int     @id @default(autoincrement())
  date    String // YYYY-MM-DD (fecha de origen)
  opId    String // ID de operación en Mercado Pago
  medio   String // Tarjeta de crédito | Transferencia bancaria | ...
  bruto   Float // valor de la compra
  neto    Float // monto neto de la operación (tras comisiones y retenciones)
  release String? // fecha de liberación del dinero

  @@index([date])
}

/// Pedido web de Shopify (Plazet o Natural Light). Se sincroniza por API
/// (client credentials) y se concilia contra los cobros de Mercado Pago —
/// las dos tiendas cobran la web por la MISMA cuenta MP ya cargada.
model ShopifyOrder {
  id         Int     @id @default(autoincrement())
  shop       String // PLAZET | NL
  name       String // "#Plazet1801" / nombre del pedido
  orderId    String  @unique // id numérico del pedido en Shopify
  date       String // YYYY-MM-DD del PAGO, en hora Colombia (UTC-5)
  amount     Float // total cobrado (transacciones SALE/CAPTURE exitosas)
  refund     Float   @default(0) // total reembolsado
  refundDate String? // YYYY-MM-DD Colombia del último reembolso
  gateway    String // "Mercado Pago Checkout Pro", etc.
  financial  String // PAID | REFUNDED | PARTIALLY_REFUNDED | ...

  @@index([date])
  @@index([shop])
}

/// Transacción del reporte Conciliar del datafono
model DataphoneEntry {
  id            Int     @id @default(autoincrement())
  txDate        String // YYYY-MM-DD
  depositDate   String
  establishment String
  storeCode     String?
  franchise     String
  cardType      String
  gross         Float
  net           Float
  terminal      String

  @@index([txDate])
}

/// Nota de revisión que Paola deja sobre un día/tienda/canal mientras revisa
/// diferencias ("esto es un pendiente", "la asesora dice X"). Claude las lee
/// después para analizarlas y cuadrar juntas lo que haga falta.
model DayNote {
  id        Int      @id @default(autoincrement())
  date      String // YYYY-MM-DD
  storeCode String? // null = nota de empresa (ej. QR global)
  channel   String // efectivo | datafono | qr | mercadopago | otro
  note      String
  autor     String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  adjuntos  NoteAttachment[]

  @@index([date])
}

/// Imagen (foto del comprobante) pegada a una nota de revisión. Se guarda en
/// la misma BD (volumen bajo, comprimida en el navegador a ≤1600px JPEG).
model NoteAttachment {
  id        Int      @id @default(autoincrement())
  noteId    Int
  note      DayNote  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([noteId])
}

/// Pago recibido según ALEGRA, con su CUENTA destino (QR Bancolombia,
/// Rappi/Addi, Mercadopago, Credibanco, Alianza, Efectivo POS...). Es el
/// detalle que los reportes descargables no traen: permite saber si una venta
/// "transferencia" fue de verdad QR o entró por otra plataforma.
model AlegraPago {
  id       Int     @id @default(autoincrement())
  alegraId String  @unique // id del pago en Alegra
  date     String // YYYY-MM-DD
  amount   Float
  cuenta   String // nombre de la cuenta destino en Alegra
  metodo   String // cash | transfer | debit-card | credit-card | ...
  invoice  String? // número de la primera factura asociada (ej. B2122)

  @@index([date])
}

/// Asignación MANUAL de un pago QR del banco a una tienda (para los empates:
/// mismo valor vendido en 2+ tiendas el mismo día y menos pagos que ventas).
/// Se guarda por (date, amount, payer) — no por id — para sobrevivir a las
/// recargas del extracto (recargar borra y recrea QrEntry).
model QrAssignment {
  id        Int      @id @default(autoincrement())
  date      String // YYYY-MM-DD del pago en el banco
  amount    Float
  payer     String
  storeCode String
  note      String?
  createdAt DateTime @default(now())

  @@unique([date, amount, payer])
}

/// Estado de cierre de un mes de conciliación
model MonthStatus {
  id           Int       @id @default(autoincrement())
  month        String    @unique // YYYY-MM
  closed       Boolean   @default(false)
  closedAt     DateTime?
  closedBy     String? // email de quien cerró
  snapshotJson String    @default("[]") // foto de los resultados al cerrar (se sirve congelada)
  note         String?
}

/// Ajuste manual persistente (por id estable del resultado)
model Adjustment {
  id         Int    @id @default(autoincrement())
  resultId   String @unique // id del ConciliationResult (ej. EFECTIVO:B1:2026-06-05)
  salesDates String // JSON array de YYYY-MM-DD
  note       String
}

/// Auditoría de archivos cargados
model Upload {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  filename  String
  kind      String // alegra | alegra_trans | banco | datafono | datafono_banco | historico
  dateFrom  String? // rango de fechas que cubrió (y reemplazó)
  dateTo    String?
  rows      Int      @default(0)
  skipped   Int      @default(0) // filas omitidas por caer en mes cerrado
}
